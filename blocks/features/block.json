{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ramboeck/features",
	"version": "1.0.0",
	"title": "Features",
	"category": "ramboeck",
	"icon": "star-filled",
	"description": "Feature-Liste mit Icons.",
	"keywords": ["features", "vorteile", "liste"],
	"textdomain": "ramboeck",
	"attributes": {
		"features": {
			"type": "array",
			"default": []
		},
		"columns": {
			"type": "number",
			"default": 3
		}
	},
	"supports": {
		"align": ["wide", "full"],
		"html": false
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
