{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"duotone": [],
			"palette": [
				{
					"slug": "primary",
					"color": "#3b82f6",
					"name": "Primary"
				},
				{
					"slug": "primary-dark",
					"color": "#2563eb",
					"name": "Primary Dark"
				},
				{
					"slug": "secondary",
					"color": "#1e40af",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#f97316",
					"name": "Accent"
				},
				{
					"slug": "accent-dark",
					"color": "#ea580c",
					"name": "Accent Dark"
				},
				{
					"slug": "text",
					"color": "#0f172a",
					"name": "Text"
				},
				{
					"slug": "text-muted",
					"color": "#64748b",
					"name": "Text Muted"
				},
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "Background"
				},
				{
					"slug": "background-alt",
					"color": "#f8fafc",
					"name": "Background Alt"
				},
				{
					"slug": "border",
					"color": "#e2e8f0",
					"name": "Border"
				},
				{
					"slug": "success",
					"color": "#22c55e",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#eab308",
					"name": "Warning"
				},
				{
					"slug": "error",
					"color": "#ef4444",
					"name": "Error"
				}
			]
		},
		"typography": {
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
					"slug": "primary",
					"name": "Primary (Inter)",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/inter-regular.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "500",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/inter-medium.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "600",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/inter-semibold.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/inter-bold.woff2"]
						}
					]
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
					"slug": "mono",
					"name": "Monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "clamp(0.875rem, 0.8rem + 0.25vw, 0.9375rem)",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "clamp(1rem, 0.9rem + 0.5vw, 1.125rem)",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "clamp(1.125rem, 1rem + 0.5vw, 1.25rem)",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem)",
					"name": "XL"
				},
				{
					"slug": "xx-large",
					"size": "clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem)",
					"name": "2XL"
				},
				{
					"slug": "xxx-large",
					"size": "clamp(2rem, 1.5rem + 2.5vw, 3.5rem)",
					"name": "3XL"
				}
			]
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "10",
					"size": "clamp(0.25rem, 0.2rem + 0.25vw, 0.5rem)",
					"name": "2XS"
				},
				{
					"slug": "20",
					"size": "clamp(0.5rem, 0.4rem + 0.5vw, 0.75rem)",
					"name": "XS"
				},
				{
					"slug": "30",
					"size": "clamp(0.75rem, 0.6rem + 0.75vw, 1rem)",
					"name": "S"
				},
				{
					"slug": "40",
					"size": "clamp(1rem, 0.8rem + 1vw, 1.5rem)",
					"name": "M"
				},
				{
					"slug": "50",
					"size": "clamp(1.5rem, 1.2rem + 1.5vw, 2rem)",
					"name": "L"
				},
				{
					"slug": "60",
					"size": "clamp(2rem, 1.5rem + 2.5vw, 3rem)",
					"name": "XL"
				},
				{
					"slug": "70",
					"size": "clamp(3rem, 2rem + 5vw, 5rem)",
					"name": "2XL"
				},
				{
					"slug": "80",
					"size": "clamp(4rem, 3rem + 5vw, 6rem)",
					"name": "3XL"
				}
			],
			"units": ["px", "em", "rem", "%", "vw", "vh"]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"spacing": {
				"outer": "clamp(1rem, 5vw, 2rem)"
			},
			"borderRadius": {
				"small": "0.25rem",
				"medium": "0.5rem",
				"large": "1rem",
				"full": "9999px"
			},
			"shadow": {
				"small": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
				"medium": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
				"large": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
				"xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)"
			},
			"transition": {
				"fast": "150ms ease",
				"normal": "300ms ease",
				"slow": "500ms ease"
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			},
			"core/paragraph": {
				"color": {
					"link": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--custom--spacing--outer)",
				"right": "var(--wp--custom--spacing--outer)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--text)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "var(--wp--custom--border-radius--medium)"
				},
				"typography": {
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "header-transparent",
			"title": "Header (Transparent)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "footer-minimal",
			"title": "Footer (Minimal)",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-services",
			"title": "Leistungen",
			"postTypes": ["page"]
		},
		{
			"name": "page-about",
			"title": "Über uns",
			"postTypes": ["page"]
		},
		{
			"name": "page-contact",
			"title": "Kontakt",
			"postTypes": ["page"]
		},
		{
			"name": "page-legal",
			"title": "Legal (Impressum, Datenschutz)",
			"postTypes": ["page"]
		}
	]
}
